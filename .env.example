# ============================================================
# 环境变量模板
# ------------------------------------------------------------
# 用法：
#   cp .env.example .env      （Windows: copy .env.example .env）
#   然后把下面的值改成你自己的。
#
# 为什么密钥要单独放 .env：
#   写进 config.yaml 再提交到 git 是最常见的泄密方式——
#   git 历史会永久保留，事后删文件也删不干净。
#   仓库里只保留占位符（config.yaml 里的 ${LLM_API_KEY}），
#   真实值由 .env 或系统环境变量提供，.env 已被 .gitignore 忽略。
#
# 【零配置也能跑】
#   把 LLM_PROVIDER / EMBEDDINGS_PROVIDER 都留成 mock，
#   就不需要任何 Key，整条流水线依然能完整跑通（便于学习与演示）。
# ============================================================

# ---- 大模型 ----
LLM_PROVIDER=mock
LLM_MODEL=qwen-plus
# 任何 OpenAI 兼容端点都可用（阿里云 MaaS / DeepSeek / 腾讯混元 / vLLM 自建…）
LLM_BASE_URL=https://your-endpoint/compatible-mode/v1
LLM_API_KEY=sk-your-key-here

# ---- 嵌入模型 ----
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODEL=text-embedding-v3
EMBEDDINGS_BASE_URL=https://your-endpoint/compatible-mode/v1
EMBEDDINGS_API_KEY=sk-your-key-here